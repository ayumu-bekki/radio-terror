# 192. シグナル (docs/puzzle_stage_ideas.md §2.1) — **無効化中**
# 「緑・赤・黄の順でボタンを押してください」を無線指示のみで伝える。
#
# ## 無効化した理由 (2026-08-24)
#
# **103 コール&レスポンス と構造が同じで、104 のほうが教える内容が多い。**
#
#              | 192 (これ)        | 103 コール&レスポンス
#   -----------|-------------------|--------------------------
#   表示       | 点灯1色 (= 切る線) | 点灯1色 + 点滅1色
#   押す数     | 3個               | 3個
#   切る線     | **点灯**した色     | **点滅**した色 (点灯とは別)
#
# どちらも「ナビに言われた色のボタンを順に押して、指示された線を切る」で、
# プレイヤー体験はほぼ同じだった。違いは切る線が点灯か点滅かだけ。
#
# **104 だけが「報告した色は答えではない」を教える。** 点灯は報告させる
# ためのもので、切る線は点滅している別の色。203 ブループリント の
# 「全灯は合図」、205 速さくらべ の「点灯は基準外」へ繋がる素地になる。
# 192 は「点灯 = 切る線」なので、この一段のひねりが無い。
#
# **192 の丁寧なヒント文面は 104 へ移植済み** (第一声で指示しない・
# 報告と照合してから列を渡す・押す数3個)。失われたものは無い。
#
# ## 復活させるなら
#
# 104 と**別のことを教える**形にすること。押す数や色の割り当てを
# 変えるだけでは 104 と重複したままになる。

id = "192"
name = "シグナル"
difficulty = "easy"

[random]
cut = { pick = "line" }
# 押すボタンの並び。同じ色の重複は許すが、3つ選ぶ。
#
# **押下色から ${cut} を外す**。ボタンの色名はこちらから読み上げる仕様
# (下記 procedure) なので、列に正解色が混ざると L1 の第一声で正解色を
# 音として出してしまい、後段の「その色の線を切れ」と繋がった瞬間に答えが割れる。
# 押下色と cut は独立に抽選されるため、300シードで測ると 49% で衝突していた。
# 103/394 が hold と cut を分けているのと同じ理由。
p1 = { pick = "color", exclude = ["${cut}"] }
p2 = { pick = "color", exclude = ["${cut}"] }
p3 = { pick = "color", exclude = ["${cut}"] }

[core]
leds = { "${cut}" = "on" }
cut = "${cut}"
precondition = { push_seq = { entries = [
  { push = "${p1}" },
  { push = "${p2}" },
  { push = "${p3}" },
], on_wrong_press = { action = "penalty", penalty_ms = 3000 } } }

[navigator]
briefing = "3つのボタンを指定の順番で押すと解除ロックが外れる。その後、光っているランプと同じ色の線を切る。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "ランプが1つだけ点灯していることを報告できたか。色名まで言えていればなおよい"
answer = "正解はボタンを${p1}→${p2}→${p3}の順に押してから、${cut}色の線を切ること。${cut}色のランプだけが点灯している。"
# **ボタンの並びは装置に一切現れない。最初から読み上げる。**
# 押す順番はナビゲーターだけが知っており、プレイヤーは観察でも推理でも
# たどり着けない。「決まった順番がある」とだけ伝えて色を伏せると、
# プレイヤーは手詰まりになり、無線が「順番を教えて」の往復で浪費される
# (実プレイで発生)。**伏せるべきなのは推理できる情報だけ**。
#
# ヒント段階で調整するのは「一度に何色まで言うか」であって、
# 言うか言わないかではない。
#
# 一方 **切る線はプレイヤーに報告させる**。点灯しているのは正解の色だけなので、
# 「光っているランプは何色か」を尋ねれば報告 → 指示 の往復になる (101 と同じ形)。
procedure = "**第一声はランプの状態を尋ねるだけにする**(『ランプはどうなっている?』)。**ここでボタンの指示をしてはいけない** — 尋ねておきながら返事を待たずに指示すると、尋ねた意味がなくなる。報告を受けたら、**次の発話で**1色目を必ず色名で伝える(「まず${p1}のボタン」と色名を出す)。押せたら次の色、と1色ずつ進める。聞き返されたら何度でも繰り返す。3色を押し終わったら『光っているランプは何色か』を尋ね、報告を復唱してから**「その色の線」**を切るよう指示する。**切る線の色名だけはプレイヤーに先に言わせること**(ボタンの色名はこちらから言ってよい)。"
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。**この第一声ではボタンの指示をしない**。報告が装置の状態(1つだけ点灯)と一致したら、『それは順番に押すタイプだ』と種類を伝えたうえで1色目(${p1})を色名で伝え、押せたか確認する。**報告より先に順番を求められても答えず、まずランプを尋ね返すこと**。押す順番はナビゲーターしか知らないので、照合のあとは必ず教えること"
hint_l2 = "残りの色を1色ずつ伝えて進める。押せたところまでを都度確認する"
hint_l3 = "3色の並び(${p1}→${p2}→${p3})をまとめて伝えてよい。押し終わったら光っているランプの色を報告させ、その色の線を切るよう指示する"
