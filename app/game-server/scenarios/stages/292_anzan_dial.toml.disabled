# 292. 暗算ダイヤル (docs/puzzle_stage_ideas.md §2.2) — **無効化中**
#
# 「光っているランプの数」と「タイマーの秒の一の位」を**足した数**の位置に
# ダイヤルを合わせて切る。時間が進むと正解の位置も変わり続けるため、
# 暗算しながら追いかけることになる……という意図だった。
#
# ## 無効化した理由 (2026-08-24)
#
# **(1) 秒の一の位は物理的に狙えない。**
# 一の位は**1秒ごとに変わる**。猶予 (kGraceMs = 1秒) を足しても
# 条件が成立している窓は**約2秒**しかない。その2秒でプレイヤーは
#
#   タイマーを読む → 点灯数を足す → ダイヤルを回す → 線を切る
#
# を終える必要がある。**セーフティーグラス着用・立ったまま・無線で
# 急かされている**状態で、ダイヤルを回し終えた頃には一の位はもう次の値。
# 当たるとすれば「たまたま合っていた」ときだけで、実力ではなく運になる。
#
# 同じ仕組みの 303 追いかけダイヤル (ハード) が**十の位**を使うため
# 10秒間ずっと同じ値で、読む→回す→切るが余裕をもって収まる。
# **ノーマルの 292 のほうがハードの 302 より厳しい**という逆転が起きていた。
#
# **(2) 足し算が難度になっていない。**
# 判定は `(タイマー一の位 + 点灯数) == ダイヤル位置` で、点灯数は
# **定数のオフセット**にしかならない。点灯数が変わってもプレイヤーの動作は
# 「タイマーを見てダイヤルを合わせる」で同じで、変わるのは目盛りが
# 1〜2ずれることだけ。**一度覚えれば以降ずっと同じズレ**なので、
# 暗算しているのは最初の1回だけ。以降は 302 とまったく同じ作業になる。
#
# さらに点灯数が増えるほど**切れる時間帯が減る** (点灯1個なら一の位0-4 の
# 5通り / 点灯2個なら0-3 の4通り) ため、足し算は難度ではなく**待ち時間**を
# 増やしていた。
#
# ## 復活させるなら
#
# **桁を十の位に変える** (302 と同じ 10秒窓にする) のが最小の修正。
# ただしそれだけだと 302 とほぼ同じになるため、暗算の工程を
# 「一度覚えたら終わり」にならない形へ作り替える必要がある。
#
# **ファーム側の対応は不要**。`timer_digit` の `offset` は
# `core-system/main/timer_digit_rule.h` に実装済みで、
# 292 が唯一の利用者だったが**機能自体は残してある** (§5)。

id = "292"
name = "暗算ダイヤル"
difficulty = "normal"

[random]
cut = { pick = "line" }
# 点灯させるランプの数 (= 足す数)。合計が0-5に収まる時間帯を確保するため小さめ
lit_count = { pick = "int", min = 1, max = 2 }
# 点灯させる色 (cut と重なってもよい。数だけが意味を持つ)
lit = { pick = "colors", count = "${lit_count}" }

[core]
leds = { "${lit}" = "on" }
cut = "${cut}"
# 「タイマーの一の位 + 点灯数 == ダイヤル位置」で判定する
precondition = { timer_digit = { digit = "ones", match = "rotary", offset = "${lit_count}" } }

[navigator]
briefing = "点灯しているランプの数と、タイマーの秒の一の位を足した数。その位置にダイヤルを合わせた状態で線を切る。時間が進むと正解の位置も変わる。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "**点灯しているランプの数**を報告できたか。数が言えていれば報告できたとみなす"
answer = "点灯しているランプは${lit_count}個。「タイマーの秒の一の位 + ${lit_count}」がダイヤルの位置になる。その状態で${cut}色の線を切るのが正解。ダイヤルは0-5しかないため、合計が6以上になる時間帯は切れない(待つ必要がある)。"
procedure = "まず点灯しているランプの数を数えさせる。次に『その数とタイマーの一の位を足した位置にダイヤルを合わせる』と計算ルールを伝える。表示は「123.4」形式なので『小数点のすぐ左の数字』と言い換える。無線にタイムラグがあるため、ナビゲーターが「今切れ」と合図するのではなく、プレイヤー自身に条件に合うタイミングを狙わせること。合計が6以上になる時間帯は合わせられないので、待つよう助言する。"
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。点灯しているランプの数を数えさせ、タイマーの数字にも意味があることに気づかせる"
hint_l2 = "ランプの数とタイマーの一の位を足すこと、その数がダイヤルの位置になることを伝える"
hint_l3 = "計算方法を具体的に伝え、合わせられない時間帯は待つよう指示してよい(切る線の色は言わない)"
