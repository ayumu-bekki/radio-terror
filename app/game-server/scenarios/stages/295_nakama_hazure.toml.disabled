# 295. 仲間はずれ (docs/puzzle_stage_ideas.md §2.2) — **無効化中**
# 5つのLEDのうち1つだけ点滅周期が違う。「仲間外れの色」の線を切る。
#
# ## 無効化した理由 (2026-08-24)
#
# **207 息が合わない と作業が同一で、208 のほうが上位互換。**
#
#                | 表示        | 差のつけ方                        | 作業
#   -------------|-------------|-----------------------------------|------------------
#   295 (これ)   | 5色点滅     | **周期**が違う                    | 浮いた1色を探す
#   208 息が…    | 5色点滅     | **点灯比**が違う (周期は同じ800ms) | 浮いた1色を探す
#   206 速さ…    | 1点灯+4点滅 | 4段階の速度                       | 並べ替えて N番目
#
# **(1) 見た目も作業も 208 と同じ。** どちらも「5色が点滅していて1色だけ
# 浮いている」で、違うのは差のつけ方だけ。プレイヤーには区別がつかない。
#
# **(2) 208 のほうが観察として面白い。** 295 は「速いか遅いか」なので
# **1色ずつ見れば分かる**。208 は周期が全部同じで速さでは区別できず、
# **揃って明滅する4色との対比**でしか見つからない。ナビの
# 「息が合っていない色はないか」という言い回しも成立する。
#
# **(3) 「浮いた1色を探す」枠は 208、「並べ替える」枠は 206 が担う。**
# 295 はその間に何も足していない。2026-08-24 に「速い/遅いを抽選する」
# 改修を入れたが、それでも 208 との重複は解消しなかった
# (どちらも浮いた1色を探す作業のまま)。
#
# ## 復活させるなら
#
# 208 と**別の観察**にすること。周期でも点灯比でもない軸
# (色の組み合わせ・並びの規則性など) が要る。
# 単に差のつけ方を変えるだけでは 208 と重複したままになる。
#
# ## 「仲間はずれ」を本当に探させる (2026-08-24)
#
# かつては `cut` が**必ず速い側**に固定されていた。そのため
# 「浮いているものを探す」必要が無く、**「一番速いのを探す」だけで当たった** —
# 104 早い者勝ち (イージー) と同じ作業で、ノーマルに置く意味が薄かった。
#
# **速い仲間はずれと遅い仲間はずれを毎回抽選する。** どちらに転ぶか
# 分からないので、「速いほう」の癖で押すと外れる。5色を見比べて
# **他と揃っていないもの**を見つける課題になり、105 とも 208 とも分かれる。
#
# ## 速度
#
# 隣接比 2.2倍 (300 / 650ms)。旧版は 200 vs 650 の 3.25倍で、
# 205 速さくらべ (隣接 1.4〜2.0倍) より易しくノーマルとして緩かった。
# ただし 208 と違い**4色が同じ速さで揃っている**ため、
# 比較対象が明確で 208 ほど厳しくはならない。
#
# 点滅は対称 (点灯時間=消灯時間)。モールス表示のステージ (203/305) と
# 混同されないようにする。

id = "295"
name = "仲間はずれ"
difficulty = "normal"

[random]
cut = { pick = "line" } # 周期が違う1つ = 正解
# 残り4色 (${rest}) は同じ周期で点滅する。

# **仲間はずれが速いか遅いかを毎回抽選する**。
# これを固定すると「一番速いのを探す」で当たってしまう (上のコメント)。
odd = { pick = "choice", candidates = ["fast", "slow"] }

# 抽選結果から実際の点滅速度を引く。**cut と rest を別々に人手で書かない** —
# 片方だけ直し忘れると「5色とも同じ速さ」になり、謎が成立しなくなる。
odd_ms = { derive = "choice_value", from = "${odd}", fast = "300", slow = "650" }
rest_ms = { derive = "choice_value", from = "${odd}", fast = "650", slow = "300" }

[core]
# ${cut} だけ他と違う速さ、それ以外 (rest) は揃った速さで点滅する。
# どちらが速いかは ${odd} の抽選で毎回変わる。
leds = { "${cut}" = { pattern = "blink", on_ms = "${odd_ms}", off_ms = "${odd_ms}" }, "${rest}" = { pattern = "blink", on_ms = "${rest_ms}", off_ms = "${rest_ms}" } }
cut = "${cut}"

[navigator]
briefing = "5つのランプが全て点滅しているが、1つだけ点滅の速さが違う。その仲間外れの色の線を切る。**速い方が仲間外れとは限らない** — 4色が揃っていて1色だけ浮いている、その浮いている色が正解。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "**5つとも点滅している**ことを報告できたか。さらに『1つだけ速さが違う』ことまで言えていれば確実に報告できたとみなす。速い/遅いのどちらとして報告されてもよい"
# **「速い方」と書かない**。仲間はずれが速い回と遅い回が抽選で入れ替わるため
# (${odd})、固定の言い方を書くと**外れた回にナビゲーターが嘘を言う**。
# 抽選値から機械的に導いた ${odd_ms} / ${rest_ms} で書く。
answer = "正解は${cut}色の線。他の4色は${rest_ms}ミリ秒周期で揃って点滅しており、${cut}色だけが${odd_ms}ミリ秒周期で**浮いている**。**速い方が正解とは限らない** — 今回どちらなのかは上の数値で判断すること。ミリ秒の数値そのものはプレイヤーに言わない(装置に目盛りは無く、見比べて分かるのは速い/遅いだけ)。"
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。**報告の内容で返し方を変える** — 『5つとも点滅している』までなら、**速さが全部同じか**を確かめるよう観点を示す。**1つだけ速さが違うと報告できていれば、そこで止めずに『その仲間外れが正解だ』と判断基準を伝える**(色名は言わない)。報告済みの相手に『見比べてください』と返してはいけない。**『速い方を探せ』とは言わない** — 仲間はずれが遅い回もあるため、そう言うと外れた回に誤誘導になる。『4つ揃っていて1つだけ違うもの』という言い方をする"
hint_l2 = "点滅の速さが全部同じか確認させる。1つだけ違うものがあることに気づかせる。**速いか遅いかは指定しない** — 揃っている4つに対して浮いているものを探させる"
hint_l3 = "「他と点滅の速さが違う1色の線を切る」と手順を教えてよい(色名は言わない)。**速い/遅いのどちらかは言わない** — 4つ揃っているほうを基準に、浮いている1色を選ばせる"
