# 204. 切るな危険 (docs/puzzle_stage_ideas.md §2.2) — **無効化中**
# 「消えているLEDの色の線は絶対に切るな。残りのうち点滅が遅い方を切れ」。
#
# ## 無効化した理由 (2026-08-24)
#
# **(1) 「切るな」の警告に実態が無い。**
# 誤切断は**どの線でも即爆発**する (ADR S-2b)。消灯線を切っても、点滅の
# 速い方を切っても結果は同じで、消灯線に固有のリスクは存在しない。
# ブリーフィングは「絶対に切るな」と強く警告するが、**切る理由がそもそも
# 無い線**を禁じているだけ。強調するほどプレイヤーは特別な罠を疑うのに、
# 実際には何も無い。
#
# **(2) 謎の本体が 104 早い者勝ち の下位互換。**
# 警告を差し引くと「点滅2つのうち遅い方を切る」だけが残り、これは
# 104 (イージー) の速い/遅いを反転しただけになる。
# しかも点滅差が**大きく、見分けやすかった**:
#
#   291 (これ)     150ms vs 800ms   → 5.33倍   ← 最も見分けやすい
#   104 (easy)     150ms vs 300ms   → 2.0倍    (2026-08-24 に 700ms から締めた)
#   205 (normal)   150/300/550/1000 → 隣接 1.4〜2.0倍
#
# ノーマルに置きながら**イージーより易しい**という逆転が起きていた。
# 速さ比べの謎は **104 (2色) と 205 速さくらべ (4色・順位を抽選) が担う**ので、
# 間を埋める必要も無い。
#
# 191 いくつ光ってる? と同じ判断 (謎の本体を別ステージが担っているため外す)。
#
# ## 復活させるなら
#
# 「切るな」を**本物の危険にする**こと。消灯線に触れること自体が
# 罰を生む仕組み (forbidden_rotary と同じ発想) が要る。
# あわせて点滅差を 208 並み (隣接 1.4〜2倍) へ縮める。

id = "291"
name = "切るな危険"
difficulty = "normal"

[random]
cut = { pick = "line" }                          # 点滅が遅い方 = 正解
fast = { pick = "color", exclude = ["${cut}"] }  # 点滅が速い方 = 不正解
# 残り3色は消灯 (= 絶対に切ってはいけない線)

[core]
leds = { "${cut}" = { pattern = "blink", on_ms = 800, off_ms = 800 }, "${fast}" = { pattern = "blink", on_ms = 150, off_ms = 150 } }
cut = "${cut}"

[navigator]
briefing = "消えているランプの色の線は絶対に切ってはいけない。点滅している2本のうち、遅い方が正解。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "**2つが点滅していて残りは消えている**ことを報告できたか。さらに点滅2つの速さに差がある(片方が速く・片方が遅い)ことまで言えていれば確実に報告できたとみなす。言い回しは問わない"
answer = "正解は${cut}色の線(${fast}色より点滅が遅い方)。消灯している線を切ると即座に失敗する。"
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。**消えている色の線は絶対に切ってはいけないことは、報告を受けたらすぐ警告する**(誤って切ると即失敗するため出し惜しみしない)。そのうえで**報告の内容で返し方を変える** — 『2つ点滅・3つ消灯』までなら、点滅している2つの**速さに違いがないか**を見るよう観点を示す。**速い/遅いの差まで報告できていれば、そこで止めずに『遅い方が正解だ』と判断基準を伝える**(色名は言わない)"
hint_l2 = "消えている色の線は危険であること、点滅している2本を比べることを伝える"
hint_l3 = "「点滅が遅い方の色の線を切る」と手順を教えてよい(色名は言わない)"
