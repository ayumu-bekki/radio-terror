# 106. いくつ光ってる? (docs/puzzle_stage_ideas.md §2.1)
# 「光っているランプの数と同じ位置にロータリーを合わせて○色を切れ」。
# 点灯数がそのままロータリー位置になるため、count は 0-5 の範囲に収める。

id = "106"
name = "いくつ光ってる?"
difficulty = "easy"

[random]
cut = { pick = "line" }
# 点灯させるLEDの数 (= 合わせるロータリー位置)。1-5から抽選する
lit_count = { pick = "int", min = 1, max = 5 }
# 点灯させるLEDを lit_count 個選ぶ
lit = { pick = "colors", count = "${lit_count}" }

[core]
# lit で選ばれた色を全て点灯させる
leds = { "${lit}" = "on" }
cut = "${cut}"
precondition = { rotary = "${lit_count}" }

[navigator]
briefing = "点灯しているランプの数を数え、その数と同じ位置にダイヤルを合わせてから指定の線を切る。点灯しているランプは数を表すだけで、切る線の色とは関係がない。"
answer = "点灯しているランプは${lit_count}個。ダイヤルを${lit_count}に合わせて${cut}色の線を切るのが正解。切る線の色は装置に現れないため、${cut}色は最初から伝えてよい。"
# **切る線の色は装置から読み取れない。**
# 点灯色 (${lit}) は数を作るためだけに抽選され、${cut} とは独立している。
# 実測では 45% のセッションで正解色のランプが消灯しており、伏せると
# プレイヤーは手詰まりになる (「装置に現れない情報は出し惜しみしない」の原則)。
# このステージの謎は**数を数えてダイヤルへ移すこと**であって、色当てではない。
procedure = "まず点灯しているランプの数を数えさせ、その数をダイヤルに合わせさせる。切る線の色 (${cut}色) は装置から読み取れないので、こちらから伝える。点灯している色は数を表すだけで切る線とは無関係なため、プレイヤーが点灯色を切ろうとしていたら訂正する。"
hint_l1 = "点灯しているランプがいくつあるか数えさせる。切る線が${cut}色であることも併せて伝えてよい (装置からは分からないため)"
hint_l2 = "数えた数とダイヤルの数字に関係があることに気づかせる"
hint_l3 = "「点灯している数と同じ位置にダイヤルを合わせる」と手順を教えてよい。切る線の色は装置から読み取れないため、L1 から伝えてよい"
