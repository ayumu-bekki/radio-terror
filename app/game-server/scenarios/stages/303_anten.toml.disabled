# 303. 暗転 (docs/puzzle_stage_ideas.md §2.3)
# 各LEDが異なる周期で点滅。「全てのランプが消えた瞬間」に○色を切る。
# 周期の重なりを見切る難問。
#
# 周期は互いに素に近い値を選び、全消灯の瞬間が定期的に、かつ短く訪れるようにする。

id = "303"
name = "暗転"
difficulty = "hard"

[random]
cut = { pick = "line" }

[core]
# 5色それぞれ異なる周期で点滅させる (点灯300ms固定・消灯時間で周期を散らす)
leds = { "A" = { pattern = "blink", on_ms = 300, off_ms = 500 }, "B" = { pattern = "blink", on_ms = 300, off_ms = 700 }, "C" = { pattern = "blink", on_ms = 300, off_ms = 900 }, "D" = { pattern = "blink", on_ms = 300, off_ms = 1100 }, "E" = { pattern = "blink", on_ms = 300, off_ms = 1300 } }
cut = "${cut}"
precondition = { leds_all_off = true }
on_wrong_cut = { action = "explode" }

[navigator]
briefing = "5つのランプがそれぞれ違う周期で点滅している。全てのランプが同時に消えた瞬間に、指定の線を切る。"
# **切る線の色は装置から読み取れない。**
# 5色すべてが同じように点滅しており、${cut} は表示と無関係に抽選される。
# 伏せるとプレイヤーは色を知る手段が無く手詰まりになるため、L1 から伝える
# (「装置に現れない情報はヒントレベルで出し惜しみしない」の原則)。
# このステージの謎は**全消灯の瞬間を捉えること**であって、色当てではない。
answer = "正解は全ランプが同時消灯した瞬間に${cut}色の線を切ること。周期がバラバラなので、全消灯は一瞬しか訪れない。切る線の色は装置に現れないため、${cut}色は最初から伝えてよい。"
procedure = "全消灯の瞬間は短いので、ニッパーを構えて待つよう促す。焦らず何度でも狙い直せることを伝える(時間内であれば)。"
hint_l1 = "5つのランプの点滅がバラバラであることを確認させる。切る線が${cut}色であることも併せて伝えてよい (装置からは分からないため)"
hint_l2 = "全部が同時に消える瞬間があることに気づかせ、それを待つよう促す"
hint_l3 = "「全てのランプが消えた瞬間に切る」と手順を教えてよい。切る線の色 (${cut}色) は装置から読み取れないため、伝えてよい"
