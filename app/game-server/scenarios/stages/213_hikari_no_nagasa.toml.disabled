# 213. 光の長さ (docs/puzzle_stage_ideas.md §2.2)
#
# 5色が同じ周期で点滅するが、**光っている時間の長さ**がそれぞれ違う。
# 「N番目に長く光る色」の線を切る。
#
# 208 速さくらべは「点滅の速さ(周期)」を比べるが、こちらは周期を揃えて
# **点灯時間の比率(デューティ比)**を比べる。速さは全部同じに見えるため、
# 「どれだけ長く点いているか」に注目する必要があり、別の観察になる。
#
# 長く光る色は点きっぱなしに近く、短い色は一瞬だけ光るので、
# 両端から順位を決めていくと並べやすい。

id = "213"
name = "光の長さ"
difficulty = "normal"

[random]
# 点灯時間の長い順に並べる (c1 が最長、c5 が最短)
c1 = { pick = "color" }
c2 = { pick = "color", exclude = ["${c1}"] }
c3 = { pick = "color", exclude = ["${c1}", "${c2}"] }
c4 = { pick = "color", exclude = ["${c1}", "${c2}", "${c3}"] }
c5 = { pick = "color", exclude = ["${c1}", "${c2}", "${c3}", "${c4}"] }

# 何番目に長く光る色を切らせるか。候補を長い順に並べているので順位が確定する
cut = { pick = "choice", as_line = true, candidates = [
  "${c1}",
  "${c2}",
  "${c3}",
  "${c4}",
  "${c5}",
] }

[core]
# 周期は全色 2000ms で統一し、点灯時間だけを変える。
# c1 が最も長く(1500ms)、c5 が最も短い(250ms)。
# 周期が同じなので「速さ」では区別できず、点灯の長さを見る必要がある。
leds = { "${c1}" = { pattern = "blink", on_ms = 1500, off_ms = 500 }, "${c2}" = { pattern = "blink", on_ms = 1100, off_ms = 900 }, "${c3}" = { pattern = "blink", on_ms = 800, off_ms = 1200 }, "${c4}" = { pattern = "blink", on_ms = 500, off_ms = 1500 }, "${c5}" = { pattern = "blink", on_ms = 250, off_ms = 1750 } }
cut = "${cut}"
on_wrong_cut = { action = "explode" }

[navigator]
briefing = "5つのランプが同じ周期で点滅しているが、光っている長さがそれぞれ違う。長い順に並べて、指定された順番の色の線を切る。"
answer = "光っている時間が長い順に ${c1}(最長) → ${c2} → ${c3} → ${c4} → ${c5}(最短)。切るのは${cut}色の線。この並びの中で${cut}が何番目かを数えて『○番目に長く光る色を切れ』と伝えること。"
procedure = "『点滅の速さではなく、光っている時間の長さを見る』と観点を明確にする。消えている時間との比で判断すると分かりやすい(長く光る色はほとんど点きっぱなしに見える)。両端(一番長い・一番短い)から決めると並べやすい。"
hint_l1 = "5つのランプの点滅で、光っている時間の長さが違うことに気づかせる"
hint_l2 = "光っている長さの順に並べるよう促す。一番長いもの・一番短いものから決めると並べやすいと助言する"
hint_l3 = "切るのが何番目に長く光る色かを伝えてよい(色名は言わない)"
