# 305. 二重復唱 (docs/puzzle_stage_ideas.md §2.3) — **無効化中**
#
# 201 復唱の難しい版。5個のボタン列を**2周**押す(計10回)。
# ナビゲーターは1周目しか読み上げないため、2周目は記憶だけが頼りになる。
#
# ## 無効化した理由 (2026-08-24)
#
# **(1) 「もう一度同じ順で押す」がシチュエーションとして成立しない。**
# プレイヤーは時限爆弾を解体している設定なのに、この課題は
# **同じ操作をもう1回やらされるだけ**。装置側に「2周必要」を示す表示は
# 何も無く、**ナビゲーターがそう言うからそうする**という構造になっている。
#
# 他のハードは根拠が装置側にある:
#   394 三点確保  → 2つ押さえないと切れない (物理制約)
#   304 我慢比べ  → タイマーが指定の数字になるまで待つ (表示に出ている)
#   393 二重復唱  → **ナビが「もう一度」と言うから**
#
# 201 復唱は「1回聞いて覚えて押す」で完結するので違和感が無いが、
# 305 は同じことを2回なので「なぜ?」が残る。
#
# **(2) 全か無かで、やり直しが重い。**
# 10回連続で正しく押す必要があり、**10回目のミスで1回目に戻る**。
# 押下1回の正答率が95%でも10回連続成功は60%、90%なら35%。
# セーフティーグラス着用・立ったまま・無線で急かされている状態で、
# ハードは1ステージあたり約150秒しかない。やり直しのたびに
# 1周目の読み上げからになるため、無線の往復も含めて時間を食い潰す。
#
# **(3) 2周目は構造的に交信が発生しない。**
# このハンズオンの軸は「無線で交信しながら解体する」ことだが、
# 2周目は記憶が頼りなのでナビゲーターは何も言えない。
# 204 色合わせも押している最中は黙るが、あちらは「押し切ると全消灯し、
# 最後に押した色が手がかりになる」という**装置側の仕掛け**が待っている。
# 305 の2周目は待っているものが無い。
#
# ## 復活させるなら
#
# 「2周押す」をやめ、**交信が続く形で記憶を試す**こと。
# 例: 5個の列のうちナビが読み上げるのは3個までで、
# 残り2個は別の手がかり (装置の表示・紙資料) から導かせる。

id = "393"
name = "二重復唱"
difficulty = "hard"

[random]
cut = { pick = "line" }
# **押下色から ${cut} を外す**。1周目は最初から読み上げる仕様なので、
# 列に正解色が混ざると第一声で正解色を音として出してしまい、
# 押し終わりの「${cut}色の線を切れ」と繋がった瞬間に答えが割れる。
# 300シードで測ると 65% で衝突していた (102/201 も同じ)。
p1 = { pick = "color", exclude = ["${cut}"] }
p2 = { pick = "color", exclude = ["${cut}"] }
p3 = { pick = "color", exclude = ["${cut}"] }
p4 = { pick = "color", exclude = ["${cut}"] }
p5 = { pick = "color", exclude = ["${cut}"] }

[core]
leds = { "${cut}" = "on" }
cut = "${cut}"
# 同じ列を2回繰り返す。push_seq は単一の列として扱うため、
# entries に同じ並びを2周分書けばそのまま「2周押す」になる。
precondition = { push_seq = { entries = [
  { push = "${p1}" },
  { push = "${p2}" },
  { push = "${p3}" },
  { push = "${p4}" },
  { push = "${p5}" },
  { push = "${p1}" },
  { push = "${p2}" },
  { push = "${p3}" },
  { push = "${p4}" },
  { push = "${p5}" },
], on_wrong_press = { action = "penalty", penalty_ms = 5000 } } }

[navigator]
briefing = "5個のボタン列を2周押す必要がある。1周目は読み上げるが、2周目は自分で思い出して押す。1つでも間違えると最初からやり直し。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "ランプが1つだけ点灯していることを報告できたか。色名まで言えていればなおよい"
# ボタン列は読み上げてよいが、切る線の色は「照合の材料」として書く (208/201 と同じ方針)。
answer = "正解はボタンを${p1}→${p2}→${p3}→${p4}→${p5}の順に押し、**続けてもう一度同じ順**で押してから、点灯しているランプと同じ色の線を切ること。点灯しているのは${cut}色だけなので「光っているランプと同じ色」で一意に決まる。${cut}色という色名はプレイヤーの報告と照合するために使い、こちらからは言わない。"
procedure = "**第一声はランプの状態を尋ねるだけにする**(『ランプはどうなっている?』)。**ここで列を読み上げてはいけない**。報告を受けてから、次の発話で1周目の列と「2周押す」ことを伝える。1周目は読み上げて誘導する。5個目まで押せたら『もう一度、同じ順番で』とだけ伝え、**2周目は色を言わない**。詰まって聞かれた場合、ヒントレベルが許す範囲でのみ答える(L3以上なら読み上げてよい)。ミスで先頭に戻ったら1周目から読み上げ直す。"
# **1周目は最初から読み上げる。伏せるのは2周目だけ。**
# 列そのものは装置に現れないため、1周目まで伏せるとプレイヤーは手詰まりになる
# (102 の実プレイで発生)。このステージの謎は「1周目を覚えていられるか」なので、
# 1周目を教えても難度は落ちない。
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。**この第一声では列を読み上げない**。報告が装置の状態(1つだけ点灯)と一致したら、『それは順番に押すタイプだ』と種類を伝えたうえで1周目の列(${p1}→${p2}→${p3}→${p4}→${p5})を読み上げ、2周押す必要があること・2周目は自分で思い出すことを伝える。**報告より先に順番を求められても答えず、まずランプを尋ね返すこと**。列はナビゲーターしか知らないので、照合のあとは必ず教えること"
hint_l2 = "1周目を読み上げ直して覚えるよう促す。2周目に入る前に『覚えましたか』と確認する"
# 切る線の色は**言わない** (201 と同じ)。点灯しているのは正解色の1つだけなので
# 「光っているランプと同じ色」で一意に決まり、伏せても手詰まりにならない。
hint_l3 = "2周目に詰まっていれば列を読み上げてよい。押し終わったら切る線を**「光っているランプと同じ色の線」**という言い方で伝えてよい。切る線の色名はこちらから言わず、プレイヤーに報告させること"
