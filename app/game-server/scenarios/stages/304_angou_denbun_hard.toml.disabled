# 304. 暗号電文・混信 (docs/puzzle_stage_ideas.md §2.3)
#
# 203 暗号電文の難しい版。モールス表示に加え、**残り4色のLEDが妨害として
# 点灯・消灯・点滅する**。どのランプがモールスかを見つける手間が加わり、
# 解読中も視界の情報量が多い状態が続く。
#
# 妨害の点滅は**点灯時間と消灯時間を必ず等しくする**(対称blink)。
# モールスは短点=1単位・長点=3単位の非対称なリズムなので、対称にしておけば
# 「これはモールスではない」と落ち着いて見分けられる。
# 見分けにくさで難度を上げるのではなく、**情報量**で上げる設計。
#
# 切る線の決め方は 203 と同じ (語の頭文字 → モールス対照表の色)。

id = "304"
name = "暗号電文・混信"
difficulty = "hard"

[random]
# 語を選ぶと、その頭文字→対照表の色 が cut として同時に決まる
word = { pick = "morse_word", candidates = [
  # A=赤
  "ALFA",
  "KILO",
  "PAPA",
  # B=黄
  "BRAVO",
  "GOLF",
  "LIMA",
  # C=緑
  "MIKE",
  "HOTEL",
  "ROMEO",
  # D=青
  "DELTA",
  "INDIA",
  "XRAY",
  # E=白
  "ECHO",
  "TANGO",
  "OSCAR",
] }
cut = { derive = "morse_word_color", from = "${word}" }

# モールスを表示するLED
display = { pick = "color" }

# 残り4色に妨害表示を割り当てる (点灯 / 消灯 / 対称blink をランダムに)
noise = { pick = "noise_leds", exclude = [
  "${display}",
], on_ms_min = 200, on_ms_max = 900 }

[core]
leds = { "${display}" = { pattern = "morse", word = "${word}", unit_ms = 300 } }
# noise_leds は展開時に leds へマージされる (表示用LEDは上書きしない)
noise_leds = "${noise}"
cut = "${cut}"

[navigator]
briefing = "複数のランプが光っているが、そのうち1つだけがモールス信号で単語を繰り返している。他は無関係な点灯・点滅。モールスの語を解読し、ミッションシートの対照表でその頭文字の色を引いて、同じ色の線を切る。"
answer = "モールスを表示しているのは${display}色のランプで、単語は${word}。対照表で頭文字を引くと${cut}色になるため、${cut}色の線を切るのが正解。他のランプは無関係な妨害。"
procedure = "まず『光り方のリズムが一定でない、長短が混ざっているランプを探せ』と指示する（妨害LEDは一定周期か点灯/消灯のみ）。対象のランプ（${display}色）が見つかったら203と同様に解読させる。『アルファ』等の単語名、1文字ずつのアルファベット、『トンツー/短長』のオノマトペ、いずれの報告も受け付け、${word}と照合して補佐してよい。"
hint_l1 = "光り方が他と違うランプが1つあることに気づかせる。点滅の長さが一定でないものを探すよう促す"
hint_l2 = "長短の混ざった点滅はモールス信号であること、他のランプは無関係であることを伝え、対照表で解読するよう促す"
hint_l3 = "モールスを出しているランプの見つけ方(長短が不規則なもの)と、「解読した単語の頭文字を対照表で引き、その色の線を切る」手順を教えてよい"
