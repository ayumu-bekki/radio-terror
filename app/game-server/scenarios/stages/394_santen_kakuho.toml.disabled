# 394. 三点確保 (docs/puzzle_stage_ideas.md §2.3) — **無効化中**
#
# ボタンを**2つ同時に押さえたまま**線を切る。
# 102 ホールド&カット (ボタン1つ + ダイヤル) の発展形だが、
# ダイヤル操作をなくして**保持そのものの難しさ**に寄せていた。
#
# ## 無効化した理由 (2026-08-24)
#
# **103 と競合している。** 394 は 103 からダイヤルを取り除き、
# 押さえる数を1つ増やしただけで、謎としては同じもの。
#
#              | 103 (easy)          | 394 (hard)
#   -----------|---------------------|-------------------
#   押さえる   | 1個                 | 2個
#   ダイヤル   | **あり**            | なし
#   工程       | ダイヤル→押す→切る  | 押す→切る
#
# **(1) 工程数は 394 のほうが少ない。** 103 は3段構えだが 394 は2段。
# ハードなのに**イージーの 103 より手順が短い**という逆転が起きていた
# (204・292 を無効化したのと同じ形)。
#
# **(2) 増えた「押さえる1個」が謎ではなく体力。** 増えているのは
# 観察でも推理でもなく**手の器用さ**で、他のハード
# (301・302・304 のタイミング系、305 のモールス) と質が揃わない。
#
# **(3) 押さえている最中に交信が生まれない。** ナビゲーターにできるのは
# 持ち替えの助言くらいで、無線の往復が発生しない (305 と同じ構図)。
#
# **(4) 304 我慢比べが上位互換。** 「押さえたまま**タイマーの一の位を待つ**」で、
# 押さえる要素を保ちつつ**待つ判断**が加わる。押さえ系のハードは 304 が担う。
#
# ## 復活させるなら
#
# 押さえる数を増やす以外の軸で難度を作ること。
# **押さえ系の役割分担は 103 (イージー・ダイヤル付き) と
# 304 (ハード・タイミング付き) で足りている**ので、
# 3つ目を置くなら両者と別の軸が要る。

id = "394"
name = "三点確保"
difficulty = "hard"

[random]
cut = { pick = "line" }
# 押さえる2色。切る線とは別の色にして、押さえた指が邪魔にならないようにする
hold1 = { pick = "color", exclude = ["${cut}"] }
hold2 = { pick = "color", exclude = ["${cut}", "${hold1}"] }

[core]
# 押さえる2色を点滅、切る線を点灯で示す
leds = { "${cut}" = "on", "${hold1}" = "blink", "${hold2}" = "blink" }
led_blink_ms = 600
cut = "${cut}"
precondition = { push = [
  "${hold1}",
  "${hold2}",
] }

[navigator]
briefing = "2つのボタンを同時に押さえたまま、指定の線を切る必要がある。押さえたまま切るため、手の使い方に工夫が要る。"
# observed 判定用: プレイヤーがこの観察を報告できたらヒントレベルを前倒しする
# (docs/navigator_design.md §3.2 / ADR N-35)
observation = "**点滅が2つ・点灯が1つ**であることを報告できたか。点滅と点灯の区別がついていれば、色名が無くても報告できたとみなす"
# 押さえる2色は言ってよいが、切る線の色は「照合の材料」として書く
# (208/304 と同じ方針)。「${cut}色の線を切ること」とだけ書くと、
# なぞられて L3 で色名が漏れる (ヒバリのシミュレーションで発生)。
answer = "正解は${hold1}色と${hold2}色のボタンを2つとも押さえた状態で、点灯しているランプと同じ色の線を切ること。点灯しているのは${cut}色だけなので「光っているランプと同じ色」で一意に決まる。${cut}色という色名はプレイヤーの報告と照合するために使い、こちらからは言わない(押さえるボタンの${hold1}色・${hold2}色は言ってよい)。"
# **1発話に1つずつ**。助言と注意と指示を1度に言うと60文字を超える
# (ツグミで65文字になった)。返答を待ちながら分けて伝える。
procedure = "**1回の発話で伝えるのは1つだけ**にし、返答を待ってから次へ進む。まず点滅している2つのランプが押さえるボタン、点灯しているランプが切る線であることを伝える。押さえられたら『押さえたまま切る』点を伝える。持ち替えの助言と押さえ直しの注意は、プレイヤーが困っているときだけ**単独で**返す(指示と同じ発話に足さない)。"
hint_l1 = "まず『ランプはどうなっている?』と尋ね、状態を報告させる。『点滅が2つ、点灯が1つ』という報告を引き出す。切る線の色名はこちらから言わず、プレイヤーに報告させること"
hint_l2 = "点滅している色のボタンを2つとも押さえる必要があること、押さえたまま切ることを伝える。切る線の色名はこちらから言わないこと"
# 禁止は**独立した文**で書く。括弧書きの末尾に添えると読み落とされる。
hint_l3 = "押さえる2色と、押さえたまま切る手順を伝えてよい。切る線の色名は言わないこと。点灯しているランプは1つだけなので、『光っているランプと同じ色の線』と言えば伝わる。**プレイヤーが点灯色を言っていない場合、こちらから色名を補ってはいけない** (「光っているのは赤色ですね」は復唱ではなく答えの提示)。色を確かめたいときは「何色だ?」と尋ねる"
