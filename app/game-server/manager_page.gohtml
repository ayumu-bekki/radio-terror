{{define "page"}}<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>📡 RADIO TERROR — Management Console</title>
<link rel="stylesheet" href="/manager/manager.css">
</head>
<body>
<h1>📡 RADIO TERROR — Management Console</h1>

<div id="live">{{template "live" .}}</div>

<a class="more" href="/manager/history">履歴を見る →</a>

<script>
// 描画はすべてサーバー側 (html/template)。ここは2秒ごとに
// 同じページを取り直し、進行中の部分だけ差し替える。
// ページ全体をリロードしないのは、スクロール位置とログの末尾追従を保つため。
async function refresh() {
  const live = document.getElementById('live');
  try {
    const html = await (await fetch('/manager?partial=live')).text();
    live.innerHTML = html;
    scrollLog();
  } catch (e) {
    live.querySelector('#health').innerHTML =
      '<span class="err">サーバーに接続できません</span>';
  }
}

// 交信ログは最新が見えるよう末尾へ送る
function scrollLog() {
  const log = document.getElementById('logs');
  if (log) log.scrollTop = log.scrollHeight;
}

// 選択中のセッションはクエリで持つ。差し替え後もタブの選択が保たれる
function selectSession(id) {
  const url = new URL(location.href);
  url.searchParams.set('session_id', id);
  history.replaceState(null, '', url);
  refresh();
}

// 強制爆破は風船が実際に割れる。確認文で明示する
async function detonate(deviceId) {
  if (!confirm('CoreID ' + deviceId + ' を強制爆破します。\n風船が割れます。よろしいですか?')) return;
  const res = await fetch('/manager/api/detonate?device_id=' + encodeURIComponent(deviceId),
    { method: 'POST' });
  // 409 = 進行中でない等で実行できなかった
  if (res.status === 409) alert(await res.text());
  refresh();
}

async function abort(deviceId) {
  if (!confirm('CoreID ' + deviceId + ' をリセットしますか?')) return;
  const res = await fetch('/manager/api/abort?device_id=' + encodeURIComponent(deviceId),
    { method: 'POST' });
  // 202 = サーバー側は終了したがデバイスへ届いていない
  if (res.status === 202) alert(await res.text());
  refresh();
}

scrollLog();
setInterval(refresh, 2000);
</script>
</body>
</html>
{{end}}

{{/* live は2秒ごとに差し替える範囲。進行中の状態だけを含める */}}
{{define "live"}}
<h2>デバイス</h2>
<table><thead><tr>
  <th>CoreID</th><th>状態</th><th>残り</th><th>電池</th><th>ダイヤル</th><th>配線</th><th>最終報告</th>
</tr></thead><tbody>
{{range .Devices}}
  {{/* 切断中は最後の状態が残っているだけなので、行ごと薄くして区別する */}}
  <tr{{if not .Connected}} class="offline"{{end}}>
    <td>{{.DeviceID}}</td>
    <td>
      {{- if .Connected}}<span class="state {{.State}}">{{.State}}</span>
      {{- else}}<span class="state offline">切断</span>
      {{- end}}
    </td>
    <td>{{.Remaining}}</td>
    <td><span class="{{.BatteryClass}}">{{.Battery}}</span></td>
    <td>{{.Rotary}}</td>
    {{/* 配線は色チップ+色名。切断済みは薄くして取消線を引く */}}
    <td class="lines">
      {{- range .Lines}}
      <span class="line{{if .Cut}} cut{{end}}" title="{{.Color}}{{if .Cut}} (切断済){{end}}">
        <i class="chip line-{{.Code}}"></i>{{.Color}}</span>
      {{- end}}
    </td>
    <td class="muted">{{.UpdatedAt}}</td>
  </tr>
{{else}}
  <tr><td colspan="7" class="muted">接続中のデバイスはありません</td></tr>
{{end}}
</tbody></table>

<h2>無線接続状況</h2>
<table><thead><tr>
  <th>無線</th><th>CoreID</th><th>状態</th>
</tr></thead><tbody>
{{range .Bridges}}
  {{/* 未バインドはまだ開始申告が来ていない状態。行ごと薄くして区別する */}}
  <tr{{if not .Bound}} class="offline"{{end}}>
    <td>{{.BridgeID}}</td>
    <td>{{.DeviceID}}</td>
    <td class="muted">{{.Status}}</td>
  </tr>
{{else}}
  <tr><td colspan="3" class="muted">接続中の無線はありません</td></tr>
{{end}}
</tbody></table>

<h2>セッション</h2>
<table><thead><tr>
  <th>CoreID</th><th>難易度</th><th>ナビ</th><th>状態</th><th>進行</th>
  <th>残り</th><th>現在の正解</th><th>無線</th><th></th>
</tr></thead><tbody>
{{range .Sessions}}
  <tr>
    <td>{{.DeviceID}}</td>
    <td>{{.Difficulty}}</td>
    <td>{{.Character}}</td>
    <td><span class="state {{.State}}">{{.State}}</span></td>
    <td>{{.Progress}}<br><span class="muted">{{.StageName}}</span></td>
    <td>{{.Remaining}}</td>
    <td class="answer">{{.Answer}}</td>
    <td>{{.BridgeID}}</td>
    <td class="row-actions">
      <button onclick="abort('{{.DeviceID}}')">リセット</button>
      <button class="danger" onclick="detonate('{{.DeviceID}}')">強制爆破</button>
      <a href="/manager/history/{{.SessionID}}">詳細</a>
    </td>
  </tr>
{{else}}
  <tr><td colspan="9" class="muted">進行中のセッションはありません</td></tr>
{{end}}
</tbody></table>

<h2>交信ログ / 進行記録</h2>
<div class="tabs">
{{range .Tabs}}
  <button class="tab{{if .Selected}} on{{end}}"
          onclick="selectSession('{{.SessionID}}')">CoreID {{.DeviceID}}</button>
{{end}}
{{if .SelectedSession}}
  <a class="tab" href="/manager/history/{{.SelectedSession}}">詳細を開く</a>
{{end}}
</div>
<div class="log" id="logs">
{{- if .Entries}}
{{- range .Entries}}
<span class="t">{{.Time}}</span>
{{- if .IsEvent}}<span class="{{.Class}}">{{.Message}}</span>
{{- else}}<span class="who {{.WhoClass}}">{{.Who}}</span>{{.Message}}
{{- end}}<br>
{{- end}}
{{- else}}—{{end}}
</div>
{{end}}
