{{define "page"}}<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RADIO TERROR — マネージャー画面</title>
<link rel="stylesheet" href="/manager/manager.css">
</head>
<body>
<h1>RADIO TERROR — マネージャー画面</h1>

<div id="live">{{template "live" .}}</div>

<h2>直近の履歴</h2>
<table><thead><tr>
  <th>開始時刻</th><th>Core</th><th>難易度</th><th>ナビ</th>
  <th>進行</th><th>結果</th><th></th>
</tr></thead><tbody>
{{range .History}}
  <tr>
    <td class="muted">{{.StartedAt}}</td>
    <td>{{.DeviceID}}</td>
    <td>{{.Difficulty}}</td>
    <td>{{.Character}}</td>
    <td>{{.Progress}}</td>
    <td class="{{.ResultClass}}">{{.Result}}</td>
    <td class="row-actions">
      <a href="/manager/history/{{.SessionID}}">詳細</a>
      <a href="/manager/api/transcript?session_id={{.SessionID}}">TXT</a>
    </td>
  </tr>
{{else}}
  <tr><td colspan="7" class="muted">履歴はまだありません</td></tr>
{{end}}
</tbody></table>
<a class="more" href="/manager/history">すべての履歴を見る →</a>

<script>
// 描画はすべてサーバー側 (html/template)。ここは2秒ごとに
// 同じページを取り直し、進行中の部分だけ差し替える。
// ページ全体をリロードしないのは、スクロール位置とログの末尾追従を保つため。
async function refresh() {
  const live = document.getElementById('live');
  try {
    const html = await (await fetch('/manager?partial=live')).text();
    live.innerHTML = html;
    scrollLog();
  } catch (e) {
    live.querySelector('#health').innerHTML =
      '<span class="err">サーバーに接続できません</span>';
  }
}

// 交信ログは最新が見えるよう末尾へ送る
function scrollLog() {
  const log = document.getElementById('logs');
  if (log) log.scrollTop = log.scrollHeight;
}

// 選択中のセッションはクエリで持つ。差し替え後もタブの選択が保たれる
function selectSession(id) {
  const url = new URL(location.href);
  url.searchParams.set('session_id', id);
  history.replaceState(null, '', url);
  refresh();
}

async function abort(deviceId) {
  if (!confirm('Core ' + deviceId + ' をリセットしますか?')) return;
  const res = await fetch('/manager/api/abort?device_id=' + encodeURIComponent(deviceId),
    { method: 'POST' });
  // 202 = サーバー側は終了したがデバイスへ届いていない
  if (res.status === 202) alert(await res.text());
  refresh();
}

scrollLog();
setInterval(refresh, 2000);
</script>
</body>
</html>
{{end}}

{{/* live は2秒ごとに差し替える範囲。進行中の状態だけを含める */}}
{{define "live"}}
<h2>セッション</h2>
<table><thead><tr>
  <th>Core</th><th>難易度</th><th>ナビ</th><th>状態</th><th>進行</th>
  <th>残り</th><th>現在の正解</th><th>無線</th><th></th>
</tr></thead><tbody>
{{range .Sessions}}
  <tr>
    <td>{{.DeviceID}}</td>
    <td>{{.Difficulty}}</td>
    <td>{{.Character}}</td>
    <td><span class="state {{.State}}">{{.State}}</span></td>
    <td>{{.Progress}}<br><span class="muted">{{.StageName}}</span></td>
    <td>{{.Remaining}}</td>
    <td class="answer">{{.Answer}}</td>
    <td>{{.BridgeID}}</td>
    <td class="row-actions">
      <button onclick="abort('{{.DeviceID}}')">リセット</button>
      <a href="/manager/history/{{.SessionID}}">詳細</a>
    </td>
  </tr>
{{else}}
  <tr><td colspan="9" class="muted">進行中のセッションはありません</td></tr>
{{end}}
</tbody></table>

<h2>デバイス</h2>
<table><thead><tr>
  <th>Core</th><th>状態</th><th>残り</th><th>電池</th><th>配線</th><th>最終報告</th>
</tr></thead><tbody>
{{range .Devices}}
  <tr>
    <td>{{.DeviceID}}</td>
    <td><span class="state {{.State}}">{{.State}}</span></td>
    <td>{{.Remaining}}</td>
    <td><span class="{{.BatteryClass}}">{{.Battery}}</span></td>
    <td>{{range .Lines}}<span class="{{if .Cut}}err{{end}}">{{.Color}}</span> {{end}}</td>
    <td class="muted">{{.UpdatedAt}}</td>
  </tr>
{{else}}
  <tr><td colspan="6" class="muted">接続中のデバイスはありません</td></tr>
{{end}}
</tbody></table>

<h2>無線 (bridge)</h2>
<div class="muted">
{{- if .Bridges}}{{range $i, $b := .Bridges}}{{if $i}} / {{end}}{{$b.Label}}{{end}}
{{- else}}接続中の無線はありません{{end}}
</div>

<h2>外部API / アセット</h2>
<div class="muted" id="health">
  最終成功: {{.Health.LastSuccess}} / 最終エラー:
  {{- if .Health.HasError}}
    <span class="err">{{.Health.LastError}} ({{.Health.ErrorCount}}件) {{.Health.LastMessage}}</span>
  {{- else}} —{{end}}
  <br>混線アセット: 邪魔者 {{.Health.Jamming}} / 環境 {{.Health.Ambient}} / 不穏 {{.Health.Uneasy}}
</div>

<h2>交信ログ / 進行記録</h2>
<div class="tabs">
{{range .Tabs}}
  <button class="tab{{if .Selected}} on{{end}}"
          onclick="selectSession('{{.SessionID}}')">Core {{.DeviceID}}</button>
{{end}}
{{if .SelectedSession}}
  <a class="tab" href="/manager/history/{{.SelectedSession}}">詳細を開く</a>
{{end}}
</div>
<div class="log" id="logs">
{{- if .Entries}}
{{- range .Entries}}
<span class="t">{{.Time}}</span>
{{- if .IsEvent}}<span class="{{.Class}}">{{.Message}}</span>
{{- else}}<span class="who {{.WhoClass}}">{{.Who}}</span>{{.Message}}
{{- end}}<br>
{{- end}}
{{- else}}—{{end}}
</div>
{{end}}
