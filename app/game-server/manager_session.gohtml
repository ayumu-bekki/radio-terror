{{define "page"}}<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>📡 RADIO TERROR — セッション詳細</title>
<link rel="stylesheet" href="/manager/manager.css">
{{/* 進行中のセッションだけ自動更新する。終了済みは変化しないので更新しない */}}
{{if .Live}}<meta http-equiv="refresh" content="5">{{end}}
</head>
<body>
<div class="nav">
  <a href="/manager">← Management Console</a>
  <a href="/manager/history">履歴一覧</a>
  <a href="/manager/api/transcript?session_id={{.SessionID}}">テキストで保存</a>
</div>
<h1>Core {{.DeviceID}} — {{.SessionID}}</h1>

<h2>概要</h2>
<div class="summary">
  <div><span class="k">開始時刻</span><span class="v">{{.StartedAt}}</span></div>
  <div><span class="k">Core</span><span class="v">{{.DeviceID}}</span></div>
  <div><span class="k">難易度</span><span class="v">{{.Difficulty}}</span></div>
  <div><span class="k">ナビゲーター</span><span class="v">{{.Character}}</span></div>
  <div><span class="k">状態</span><span class="v"><span class="state {{.State}}">{{.State}}</span></span></div>
  <div><span class="k">進行</span><span class="v">{{.Progress}}</span></div>
  <div><span class="k">結果</span><span class="v {{.ResultClass}}">{{.Result}}</span></div>
  <div><span class="k">スコア (残り時間)</span><span class="v">{{.Score}}</span></div>
  <div><span class="k">無線 (bridge)</span><span class="v">{{if .BridgeID}}{{.BridgeID}}{{else}}—{{end}}</span></div>
</div>

<h2>ステージ構成と正解</h2>
{{range .Stages}}
  <div class="stage {{.Class}}">
    <div class="head">
      <span class="no">STAGE {{.No}}</span>
      <span class="title">{{.Name}}</span>
      <span class="tid">#{{.TemplateID}}</span>
      {{if .Cut}}<span class="answer">切断: {{.Cut}}</span>{{end}}
    </div>
    <dl>
      {{range .Navigator}}
        <dt>{{.Label}}</dt>
        <dd>{{if .IsAnswer}}<span class="answer">{{.Value}}</span>{{else}}{{.Value}}{{end}}</dd>
      {{end}}
    </dl>
    <details>
      <summary>Core へ送った定義</summary>
      <pre>{{.CoreJSON}}</pre>
    </details>
  </div>
{{else}}
  <div class="muted">ステージ情報がありません</div>
{{end}}

<h2>交信ログ / 進行記録</h2>
<div class="log full">
{{- if .Entries}}
{{- range .Entries}}
<span class="t">{{.Time}}</span>
{{- if .IsEvent}}<span class="{{.Class}}">{{.Message}}</span>
{{- else}}<span class="who {{.WhoClass}}">{{.Who}}</span>{{.Message}}
{{- end}}<br>
{{- end}}
{{- else}}まだ記録がありません{{end}}
</div>
</body>
</html>
{{end}}
