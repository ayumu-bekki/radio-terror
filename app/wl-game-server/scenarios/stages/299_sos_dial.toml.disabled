# 299. SOSダイヤル (docs/puzzle_stage_ideas.md §3 — 保留中)
#
# このファイルは拡張子 .toml.disabled のためロードされない。
# 採用する場合は .toml にリネームすれば復活する (1ステージ1ファイルの利点)。
#
# 内容: 3LEDが同時にモールス点滅 (赤=S, 黄=O, 緑=S)。解読した値
# (SOS→505のS≒5・O≒0見立て) にロータリーを合わせて対応色ボタンを押す
# (5→赤, 0→黄, 5→緑。入力順は赤→黄→緑と明示) → 完了後に切断。
# 詰まったらナビゲーターがヒントで補う。

id = "299"
name = "SOSダイヤル"
difficulty = "normal"

[random]
cut = { pick = "line" }

[core]
leds = { "A" = { pattern = "morse", word = "S", unit_ms = 300 }, "B" = { pattern = "morse", word = "O", unit_ms = 300 }, "C" = { pattern = "morse", word = "S", unit_ms = 300 } }
cut = "${cut}"
# ロータリー位置条件付きの push_seq でSOS→505の入力を表現する
precondition = { push_seq = { entries = [
  { push = "A", rotary = 5 },
  { push = "B", rotary = 0 },
  { push = "C", rotary = 5 },
], on_wrong_press = { action = "retry" } } }
on_wrong_cut = { action = "explode" }

[navigator]
briefing = "3つのランプが同時にモールスで文字を表示している。解読した文字を数字に見立て、その位置にダイヤルを合わせて対応する色のボタンを押す。"
answer = "3つのランプはS/O/Sを表示している。SOS→505と見立て、ダイヤル5で赤、ダイヤル0で黄、ダイヤル5で緑を押した後、${cut}色の線を切る。"
hint_l1 = "3つのランプが別々のモールスを出していることに気づかせる"
hint_l2 = "解読するとSOSになること、それを数字に見立てられることを示唆する"
hint_l3 = "SOS→505の見立てと、ダイヤルを合わせてから対応色を押す手順を教えてよい"
